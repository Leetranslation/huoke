# ===== 应用 =====
APP_NAME=yxagent
APP_ENV=development

# ===== 数据库（M1 启用，先占位）=====
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/yxagent

# ===== Redis（M5 启用，先占位）=====
REDIS_URL=redis://localhost:6379/0

# ===== 大模型（M3 启用，先占位）=====
DASHSCOPE_API_KEY=
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== JWT =====
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 邮件（M5 启用，先占位）=====
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
