# ===== 应用 =====
APP_NAME=yxagent
APP_ENV=development

# ===== 数据库 =====
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/yxagent

# ===== Redis（Celery broker）=====
REDIS_URL=redis://localhost:6379/0

# ===== 大模型（OpenAI 兼容，默认 DeepSeek，可换 Qwen/GLM 等）=====
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# ===== 线索搜索（Tavily，免费 1000 次/月）=====
# https://tavily.com/ 注册后获取
TAVILY_API_KEY=

# ===== JWT =====
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 邮件发送（SMTP）=====
# 163 邮箱：设置 → POP3/SMTP/IMAP → 开启服务 → 获取授权码
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# ===== 邮件追踪 =====
# 追踪像素的公网地址；本地测试用内网穿透（如 cloudflared），线上填域名
PUBLIC_BASE_URL=http://127.0.0.1:8001

# ===== 测试客户 =====
# 每个获客任务自动注入一个测试客户，用于验证追踪链路
TEST_CONTACT_EMAIL=

# ===== 自动跟进参数 =====
# 距上次发送超过多少天才发下一封跟进信
FOLLOW_UP_INTERVAL_DAYS=4
# 最多跟进轮次（含首封）
FOLLOW_UP_MAX_STEPS=5
